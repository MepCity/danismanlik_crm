# ===========================================================================
# Teşvik CRM — örnek ortam değişkenleri
# ===========================================================================
# Bu dosya repo'da tutulur. Çalışan .env dosyası OLUŞTURULMAZ (geliştirmede
# container entrypoint'i ilk ayağa kalkışta bu dosyadan üretir; elle de
# `cp .env.example .env && php artisan key:generate` ile üretilebilir).
#
# DEPO PUBLIC: buraya gerçek sır, API anahtarı, parola YAZMA. Yalnızca
# geliştirme servislerinin yer tutucu değerleri burada.
# ---------------------------------------------------------------------------

APP_NAME="Teşvik CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Log ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (db servisi) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tesvik_crm
DB_USERNAME=tesvik
DB_PASSWORD=tesvik
# Test veritabanı (db-init servisi oluşturur). Geliştirmeden ayrı; testler
# SQLite değil gerçek PostgreSQL'e karşı koşar.
DB_DATABASE_TEST=tesvik_crm_test

# --- Redis (cache + queue + session) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# --- S3 / MinIO (minio servisi) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tesvik-crm
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000

# --- E-posta (mailpit servisi) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tesvik-crm.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Compose host port eşlemeleri (app değil, docker compose okur) ---
# Bu değerler yalnızca compose.yaml içindeki `ports:` satırlarını etkiler;
# uygulamanın yukarıdaki DB_*/REDIS_*/AWS_* değerlerinden bağımsızdır. Adlar
# bilinçli olarak ayrı tutuldu (PUBLISH_ öneki) ki çakışmasın.
PUBLISH_HOST=127.0.0.1
WEB_PORT=8088
PUBLISH_DB_PORT=55432
PUBLISH_REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=tesvik-crm
PUBLISH_MINIO_S3_PORT=9000
PUBLISH_MINIO_CONSOLE_PORT=9001
PUBLISH_MAILPIT_SMTP_PORT=1025
PUBLISH_MAILPIT_WEB_PORT=8025

# Container'a mount edilecek host kullanıcısının UID/GID'si (docker compose build
# arg'larına akar). Makineye özgü DEĞER YAZMA — ofis sunucusu (Linux, UID 1000)
# gibi başka makinelerde yanlış sahiplik üretir. `make up` / `make build` zaten
# `id -u` / `id -g` fallback'ini kullanır; compose da yokluğunda 1000 varsayar.
# Yalnızca Makefile'ın fallback'i yetersizse kendi değerin için iki satırı aç:
# USER_ID=  # id -u çıktın
# GROUP_ID= # id -g çıktın

VITE_APP_NAME="${APP_NAME}"

DOCUMENT_DISK=s3
DOCUMENT_MAX_SIZE_KB=10240
DOCUMENT_DOWNLOAD_LINK_MINUTES=10
DOCUMENT_SCANNER=stub
