# ==============================================================================
# BIZLIFE CRM - STAGING PILOT ORTAMI ÇEVRE DEĞİŞKENLERİ
# ==============================================================================

APP_NAME="Bizlife CRM Pilot"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://pilot.bizlife.invalid
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# VERİTABANI (PostgreSQL 17)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tesvik_crm_staging
DB_USERNAME=staging_app
DB_PASSWORD=

# ------------------------------------------------------------------------------
# REDIS (Kuyruk & Önbellek)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

# ------------------------------------------------------------------------------
# NESNE DEPOLAMA (S3 / MinIO)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=tesvik-crm-staging-documents
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# E-POSTA YAPILANDIRMASI (SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bilgi@pilot.bizlife.invalid
MAIL_FROM_NAME="Bizlife CRM Pilot"

# ------------------------------------------------------------------------------
# GÜVENLİK VE GÜVENLİ PİLOT HESAP SIRLARI (EN AZ 12 KARAKTER)
# ------------------------------------------------------------------------------
STAGING_MARKETING_EMAIL=pazarlama@pilot.bizlife.invalid
STAGING_MARKETING_PASSWORD=
STAGING_PM_EMAIL=pm@pilot.bizlife.invalid
STAGING_PM_PASSWORD=
STAGING_COMPANY_AUTHORITY_EMAIL=yetkili@pilot.bizlife.invalid
STAGING_COMPANY_AUTHORITY_PASSWORD=
STAGING_SYSTEM_ADMIN_EMAIL=admin@pilot.bizlife.invalid
STAGING_SYSTEM_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# CLOUDFLARE VE GÜVENLİK SERVİSLERİ
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
DOCUMENT_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
