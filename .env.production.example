# Bizlife CRM — üretim ortamı şablonu
# PUBLIC DEPO: bütün sır değerleri bilinçli olarak boştur. Bu dosyayı
# `.env.production` adıyla kopyalayın; gerçek değerleri repo dışında üretin.

APP_NAME="Bizlife CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tesvik_crm
DB_USERNAME=tesvik
DB_PASSWORD=
BACKUP_DB_USERNAME=tesvik_backup
BACKUP_DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=s3
DOCUMENT_DISK=s3
DOCUMENT_MAX_SIZE_KB=10240
DOCUMENT_DOWNLOAD_LINK_MINUTES=10
DOCUMENT_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Yönetilen S3: ofis makinesinden ve PostgreSQL diskinden fiziksel olarak ayrı.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Evraklar ikinci bir hesap/sağlayıcıdaki ayrı kovaya kopyalanır. Kaynakta
# silinen nesneler hedefte otomatik silinmez.
OBJECT_REPLICA_ENDPOINT=
OBJECT_REPLICA_ACCESS_KEY_ID=
OBJECT_REPLICA_SECRET_ACCESS_KEY=
OBJECT_REPLICA_BUCKET=
OBJECT_REPLICA_INTERVAL_SECONDS=300

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Dashboard'dan üretilen named tunnel token'ı.
CLOUDFLARE_TUNNEL_TOKEN=

# Uygulama nesne deposundan farklı hesap/sağlayıcı olması önerilir.
# restic istemci tarafında şifreler; repository örneği:
# s3:https://s3.example.invalid/bizlife-crm-backup
BACKUP_RESTIC_REPOSITORY=
BACKUP_RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=
BACKUP_FULL_INTERVAL_SECONDS=86400
BACKUP_WAL_INTERVAL_SECONDS=60
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_MONTHLY=12

# Slack/Teams uyumlu operasyon uyarı webhook'u. Repo dışında sır olarak tutulur.
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_SECONDS=300
MONITOR_DISK_PERCENT=80
MONITOR_QUEUE_LENGTH=100
MONITOR_BACKUP_MAX_AGE_HOURS=30
MONITOR_OBJECT_REPLICA_MAX_AGE_MINUTES=15

APP_IMAGE_TAG=latest
OPERATIONS_DELAYED_STATUS_DAYS=7
