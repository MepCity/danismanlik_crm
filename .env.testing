APP_NAME="Bizlife CRM Test"
APP_ENV=testing
# Herkese açık, yalnız test amaçlı deterministik anahtar; sır değildir.
APP_KEY=base64:MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=testing
DB_HOST=db
DB_PORT=5432
DB_DATABASE_TEST=tesvik_crm_test
DB_USERNAME=tesvik
DB_PASSWORD=tesvik

BROADCAST_CONNECTION=null
CACHE_STORE=array
FILESYSTEM_DISK=s3
MAIL_MAILER=array
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@tesvik-crm.local"
MAIL_FROM_NAME="${APP_NAME}"
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Yalnız yerel MinIO container'ının herkese açık geliştirme değerleri.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tesvik-crm
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000

DOCUMENT_DISK=s3
DOCUMENT_SCANNER=stub
NIGHTWATCH_ENABLED=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
